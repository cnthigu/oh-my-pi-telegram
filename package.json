{
  "name": "@evandrodevbr/oh-my-pi-telegram",
  "version": "0.22.0-evandro.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Telegram runtime adapter for Oh My Pi (omp) — fork of @llblab/pi-telegram 0.22.0",
  "keywords": [
    "oh-my-pi",
    "omp",
    "pi-package",
    "pi",
    "telegram",
    "bot",
    "extension"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evandrodevbr/oh-my-pi-telegram.git"
  },
  "homepage": "https://github.com/evandrodevbr/oh-my-pi-telegram",
  "bugs": {
    "url": "https://github.com/evandrodevbr/oh-my-pi-telegram/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run typecheck && npm test && npm run audit && npm run pack:check"
  },
  "files": [
    "index.ts",
    "api/",
    "lib/",
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "docs/",
    "screenshot.png"
  ],
  "exports": {
    ".": "./index.ts",
    "./inbound": "./api/inbound.ts",
    "./outbound": "./api/outbound.ts",
    "./delivery": "./api/delivery.ts",
    "./activity": "./api/activity.ts",
    "./updates": "./api/updates.ts",
    "./commands": "./api/commands.ts",
    "./sections": "./api/sections.ts",
    "./status": "./api/status.ts",
    "./voice": "./api/voice.ts",
    "./keyboard": "./api/keyboard.ts"
  },
  "omp": {
    "name": "oh-my-pi-telegram",
    "displayName": "Telegram bridge for Oh My Pi (omp)",
    "homepage": "https://github.com/evandrodevbr/oh-my-pi-telegram",
    "extensions": [
      "./index.ts"
    ],
    "compatibleWith": {
      "@oh-my-pi/pi-coding-agent": ">=16.5.2"
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.80.6",
    "@earendil-works/pi-ai": ">=0.80.6",
    "@earendil-works/pi-coding-agent": ">=0.80.6",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "undici": "8.10.2",
    "brace-expansion": "5.0.12",
    "ws": "8.21.0",
    "@earendil-works/pi-coding-agent": {
      "protobufjs": "7.6.6",
      "undici": "8.10.2",
      "brace-expansion": "5.0.12",
      "ws": "8.21.0",
      "@google/genai": {
        "protobufjs": "7.6.6",
        "ws": "8.21.0"
      },
      "@earendil-works/pi-ai": {
        "protobufjs": "7.6.6",
        "ws": "8.21.0",
        "@google/genai": {
          "protobufjs": "7.6.6",
          "ws": "8.21.0"
        }
      }
    }
  }
}
